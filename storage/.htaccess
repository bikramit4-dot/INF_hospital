# Block ALL direct web access to this directory.
# It contains the SQLite database, error logs and the one-time
# admin password file - none of which should ever be web-accessible.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
